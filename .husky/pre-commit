branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ] && [ "${ALLOW_MAIN_COMMIT:-0}" != "1" ]; then
  echo "refusing to commit directly to main (see AGENTS.md)."
  echo "create a topic branch, or set ALLOW_MAIN_COMMIT=1 to override."
  exit 1
fi

if [ "$branch" != "HEAD" ] && [ "$branch" != "main" ]; then
  case "$branch" in
    feat/*|fix/*|docs/*|refactor/*|perf/*|test/*|build/*|ci/*|chore/*|style/*|revert/*) ;;
    *)
      echo "branch '$branch' does not match <type>/<slug> (see AGENTS.md)."
      exit 1
      ;;
  esac
fi

bun run format:check
