{
  "$schema": "https://json.schemastore.org/tsconfig",

  // Typecheck the tests, which the build excludes so it cannot emit them.
  // Why this project exists and why it is not a reference:
  // ../../tsconfig.tests.base.json.
  "extends": ["./tsconfig.json", "../../tsconfig.tests.base.json"],
  "compilerOptions": { "tsBuildInfoFile": "dist/.tsbuildinfo.tests" },
  "include": ["src/**/*"],
  "exclude": []
}
