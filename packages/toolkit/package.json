{
  "name": "@plotroom/toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./toolkit.css": "./dist/toolkit.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b && vite build",
    "tokens:emit": "vite build --mode emit",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "eslint": "^9.16.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "@types/react": "^19.2.18",
    "@plotroom/typescript-config": "workspace:*",
    "@plotroom/eslint-config": "workspace:*"
  },
  "dependencies": {
    "react": "^19.2.0"
  }
}
