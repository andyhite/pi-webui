{
  "name": "@plotroom/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p bun-probes/tsconfig.json",
    "lint": "oxlint --type-aware",
    "lint:arch": "eslint .",
    "test": "bun test src",
    "probe:fts5": "bun test bun-probes/fts5-platform.test.ts"
  },
  "dependencies": {
    "@plotroom/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@plotroom/typescript-config": "workspace:*",
    "@plotroom/eslint-config": "workspace:*",
    "@types/bun": "^1.3.4"
  }
}
