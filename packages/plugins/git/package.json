{
  "name": "@plotroom/plugin-git",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer-manifest": {
      "source": "./src/renderer-manifest.ts",
      "types": "./dist/renderer-manifest.d.ts",
      "default": "./dist/renderer-manifest.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "oxlint --type-aware",
    "lint:arch": "eslint .",
    "test": "tsc -b && vitest run"
  },
  "devDependencies": {
    "@plotroom/plugin-sdk": "workspace:*",
    "@types/node": "^26.1.2",
    "@plotroom/typescript-config": "workspace:*",
    "@plotroom/eslint-config": "workspace:*"
  }
}
