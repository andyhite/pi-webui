{
  "$schema": "https://json.schemastore.org/tsconfig",

  /*
   * Typecheck the tests too — `tsconfig.json` excludes them because it is the
   * *build*, and a build that emitted its own tests into `dist/` would ship them.
   * Same arrangement as `packages/core`: same sources plus the tests, emitting
   * nothing, with the build info under `dist/` so deleting `dist/` forces a
   * recheck (AGENTS.md).
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo.tests"
  },
  "include": ["src/**/*"],
  "exclude": []
}
