{
  "extends": "@plotroom/typescript-config/base.json",
  "compilerOptions": {
    "rootDir": "src",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../plugin-sdk" },
    { "path": "../plugins/filesystem" },
    { "path": "../plugins/git" },
    { "path": "../plugins/github" },
    { "path": "../plugins/jira" },
    { "path": "../toolkit" }
  ]
}
