{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Repository tooling — `scripts/**` — which is outside the workspace project
  // graph on purpose: it is not a package, nothing imports it, and it ships
  // with nothing. It is still typechecked, because the release script decides
  // what version the product claims to be and "not part of the build" is a bad
  // reason for it to be the one file nobody checks. `pnpm typecheck:scripts`
  // runs this, and `pnpm verify` and CI both call it beside turbo's
  // per-package pass — a separate script rather than chained onto the turbo
  // one, so `pnpm typecheck --filter …` still reaches turbo.
  //
  // `allowImportingTsExtensions` with `noEmit`: Node runs these files directly
  // by stripping types, so the imports have to name the `.ts` files that
  // actually exist at runtime.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "sourceMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"]
}
