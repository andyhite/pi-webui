{
  "name": "@plotroom/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "typecheck": "tsc -b && tsc -p e2e/tsconfig.json",
    "lint": "eslint src e2e",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@plotroom/core": "workspace:*",
    "@plotroom/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@plotroom/server": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.0"
  }
}
