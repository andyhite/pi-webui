{
  "name": "@plotroom/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b && node scripts/copy-static-assets.mjs",
    "start": "electron .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy:server": "node scripts/stage-resources.mjs",
    "package": "node scripts/stage-resources.mjs && node scripts/package.mjs",
    "package:linux": "node scripts/stage-resources.mjs && node scripts/package.mjs --linux"
  },
  "description": "PlotRoom desktop shell (Electron main process)",
  "author": "PlotRoom",
  "homepage": "https://github.com/plotroom/plotroom",
  "dependencies": {
    "@plotroom/server": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "@plotroom/typescript-config": "workspace:*",
    "@plotroom/eslint-config": "workspace:*",
    "globals": "^17.9.0"
  }
}
