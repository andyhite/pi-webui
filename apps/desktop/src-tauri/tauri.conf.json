{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlotRoom",
  "version": "0.0.0",
  "identifier": "com.plotroom.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/plotroom-server"],
    "resources": ["resources/**/*"],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "http://127.0.0.1:4601/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRDE2NzI2NEI0RUZGMTcKUldRWC8wNUxKbWZSc1grUlhHaldJeEpmUnl0VWpYOWZNeFpRcnliZ2UrRnllSHN0eDN2eENXckQK",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
