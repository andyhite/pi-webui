{
  "name": "@plotroom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --conditions=source src/index.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@plotroom/core": "workspace:*",
    "@plotroom/db": "workspace:*",
    "@plotroom/plugin-filesystem": "workspace:*",
    "@plotroom/plugin-git": "workspace:*",
    "@plotroom/plugin-github": "workspace:*",
    "@plotroom/plugin-jira": "workspace:*",
    "@plotroom/plugin-sdk": "workspace:*",
    "@plotroom/session-host": "workspace:*",
    "hono": "^4.12.33",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.5",
    "@plotroom/typescript-config": "workspace:*",
    "@plotroom/eslint-config": "workspace:*"
  }
}
