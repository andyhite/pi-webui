{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // What is genuinely global now (#306): shared `tsconfig`/`eslint` config
  // moved into internal packages (`packages/config/typescript-config`,
  // `packages/config/eslint-config`), which every consumer's `tsconfig.json`
  // `extends` or `eslint.config.js` re-exports and declares as a
  // `devDependency` on. That puts the shared config in the *package graph*:
  // turbo's own dependency-based invalidation and `--affected` selection
  // reach it precisely, through the normal "a package's task is affected by
  // its dependencies changing" rule — no global list required, and no
  // over-invalidation of packages that do not consume a given config.
  //
  // `vitest.base.config.ts` is not (yet) one of those packages — every
  // package's `test` script still imports it directly by relative path, so it
  // stays a real cross-package input, but scoped to the one task that reads
  // it (see the `test` task's `inputs` below) rather than every task. `.npmrc`
  // stays here because it is install-time and genuinely repo-wide: no package
  // "depends on" it the way one depends on a workspace package.
  //
  // `turbo.json` needs no entry: turbo always hashes it, and a change to it
  // already marks everything affected. `pnpm-lock.yaml` is deliberately absent
  // too — turbo reads it semantically, which is more precise than this list
  // could be, and listing it would imply it drives selection, which it does
  // not. `.github/workflows/ci.yml` runs unfiltered on a lockfile change
  // instead, and says why.
  "globalDependencies": [".npmrc"],
  "tasks": {
    // Only real artifact builds remain (#315): `apps/web` (vite),
    // `packages/toolkit` (CSS, vite), `apps/desktop` (its own
    // `tsconfig.build.json`, until #316 replaces the shell). Every other
    // package has no `build` script at all — raw-TS `exports`, resolved
    // directly by Bun's bundler-style module resolution, nothing to emit.
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // `compile` ends by running what it built, and the artifact is ~400MB: a
    // cache hit would replay a stale smoke test and store the binary twice.
    // No `^build` anymore: nothing upstream of `apps/session-host` builds —
    // `bun src/compile.ts` reads workspace dependencies straight from
    // source, the same way `bun run dev`/`bun test` always have.
    "compile": {
      "cache": false
    },
    // #315: this used to be `tsc -b` per package, gated `dependsOn: ["build"]`
    // (the package's *own* build) specifically to keep two `tsc -b`
    // invocations from racing over the same `dist/.tsbuildinfo` and tearing
    // it (#118: measured 124-676ms overlaps, a `packages/plugins/github`
    // entry that loaded as `undefined` on a cold cache). Nothing emits a
    // `dist/` anymore, so there is no shared build artifact left to tear —
    // `typecheck` is now a single root-scoped task (`//#typecheck`, below),
    // the TypeScript 7 native compiler run once over the whole workspace,
    // and the two-project (`tsconfig.json` + `tsconfig.tests.json`) split
    // and the `dist/`-nested `.tsbuildinfo` it produced are retired with it:
    // one project checks tests directly now.
    "//#typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    // The micro-ESLint pass (#307): the two custom architectural rules plus
    // the workspace-convention rules over package.json/tsconfig.json that
    // `lint` (now `oxlint --type-aware`) cannot run -- oxlint does not lint
    // JSON, and its JS-plugin host is alpha. Split from `lint` so a package
    // with neither concern can simply omit the script.
    "lint:arch": {
      "outputs": []
    },
    // #315: no longer `dependsOn: ["^build"]` — a host suite that loads a
    // dependency's own dist (`packages/plugins/{git,github,jira}`'s
    // `host.integration.test.ts`) now loads that package's raw `src/`
    // directly, the same specifier the product resolves at runtime, so there
    // is nothing left to build first.
    "test": {
      // `$TURBO_DEFAULT$` restores the normal per-package file set; the
      // `$TURBO_ROOT$`-prefixed glob adds the one file outside every package
      // this task actually reads (#306) — verified against installed turbo
      // 2.10.8.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.base.config.ts"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
