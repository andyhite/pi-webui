{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // The configuration every package's tasks read but no package contains. A
  // task's inputs default to its own package's files, so without this a change
  // to a shared base replays cached results for every package: relaxing an
  // eslint rule kept reporting the old warnings, and it would be the same for
  // a compiler option or the shared test include. The cost is that it is
  // *global*: a lint-rule tweak busts every package's `build` and `test` cache
  // too, which per-task `inputs` cannot fix — they may not reach above a
  // package.
  "globalDependencies": [
    "tsconfig.base.json",
    "tsconfig.tests.base.json",
    "eslint.config.js",
    "vitest.base.config.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // `compile` ends by running what it built, and the artifact is ~400MB: a
    // cache hit would replay a stale smoke test and store the binary twice.
    "compile": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
