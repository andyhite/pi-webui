{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "s1-tauri-window",
  "version": "0.1.0",
  "identifier": "com.plotroom.spike",
  "build": {
    "frontendDist": "../../../apps/web/dist-spike-fixtures",
    "devUrl": "http://127.0.0.1:47811"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "s1-tauri-window",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
