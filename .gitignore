# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
*.tsbuildinfo

# Tauri (#316) — Rust build output, and the staged sidecars
# `scripts/stage-sidecars.mjs` copies in before every `cargo tauri
# build`/`dev` (regenerated, never committed; the binaries themselves are
# each app's own `out/`, already ignored above).
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/resources/

# agent orchestration runtime artifacts
.pi-subagents/

# omp project-scope plugin install state — machine-local; the sibling
# .omp/foreman.json and .omp/rules/ are committed
.omp/plugins/

# caches
.turbo/
.vite/
coverage/
playwright-report/
test-results/

# local state (spec §12: durable state lives outside the repo)
*.db
*.db-journal
*.db-wal
*.db-shm
.plotroom/

# env and secrets
.env
.env.*
!.env.example

# editors and OS
.DS_Store
.idea/
*.swp
.vscode/
