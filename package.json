{
  "name": "plotroom",
  "version": "0.0.0",
  "private": true,
  "description": "A context-authoring canvas for operating a fleet of AI agents",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "compile": "turbo run compile",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "turbo run lint",
    "lint:scripts": "eslint scripts *.config.js *.config.ts",
    "test": "turbo run test",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "release": "node scripts/release.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm typecheck && pnpm typecheck:scripts && pnpm lint && pnpm lint:scripts && pnpm test && pnpm test:scripts",
    "prepare": "husky"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.16.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
