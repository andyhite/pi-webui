{
  "name": "plotroom",
  "version": "0.0.0",
  "private": true,
  "description": "A context-authoring canvas for operating a fleet of AI agents",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "turbo run build",
    "compile": "turbo run compile",
    "dev": "turbo run dev",
    "check": "turbo run typecheck lint lint:arch test",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "lint": "turbo run lint",
    "lint:arch": "turbo run lint:arch",
    "lint:scripts": "eslint scripts *.config.js *.config.ts",
    "test": "turbo run test",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "check:scripts": "bun run lint:scripts && bun run test:scripts",
    "release": "node scripts/release.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun run format:check && bun run check && bun run check:scripts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.16.0",
    "@eslint/json": "^2.0.1",
    "@plotroom/eslint-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*",
    "packages/plugins/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.3.14",
      "onFail": "error"
    }
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "trustedDependencies": [
    "electron"
  ]
}
