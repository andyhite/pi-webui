{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The actual compiler options live in the internal config package
  // (`packages/config/typescript-config`), which is what every workspace
  // package's `tsconfig.json` extends directly (`@plotroom/typescript-config/base.json`).
  // This root file only exists for the two root-level projects that are not
  // packages themselves: `tsconfig.scripts.json` and `apps/web/e2e`'s
  // per-directory extend chain.
  "extends": "./packages/config/typescript-config/base.json"
}
